# Copy to .env and fill in. .env is gitignored and must never be committed,
# logged, screen-recorded or submitted.
WP_BASE_URL=https://example-clone.cloudwaysapps.com
WP_USER=your-wp-username
# WP Admin > Users > Profile > Application Passwords. NOT your login password.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
